# Airtable
AIRTABLE_PAT=your_personal_access_token_here
AIRTABLE_BASE_ID=your_base_id_here
# Optional — table name for the /248-anthems-v2 waitlist signup form.
# Defaults to "Waitlist". Create a table with fields:
#   Name    (single line text, required)
#   Email   (single line text, required)
#   Phone   (single line text, required)
#   Source  (single line text, optional — we send "248-anthems-v2")
#   Created (created time, optional)
AIRTABLE_WAITLIST_TABLE=Waitlist

# Perplexity (course research)
PERPLEXITY_API_KEY=your_key_here

# OpenAI / ChatGPT (script generation)
OPENAI_API_KEY=your_key_here

# Suno via KIE.ai (music generation)
SUNO_API_KEY=your_kie_ai_api_key_here

# n8n (workflow automation)
N8N_WEBHOOK_BASE_URL=https://homericng.app.n8n.cloud
N8N_MCP_SERVER_URL=https://homericng.app.n8n.cloud/mcp-server/http
